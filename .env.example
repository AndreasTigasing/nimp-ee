# ═════════════════════════════════════════════════════════════════════════
#  Streamer Site Template — environment variables
# ═════════════════════════════════════════════════════════════════════════
#  Copy to `.env.local` for local development. In CI, define the same names
#  as GitHub repository *variables* (Settings → Secrets and variables →
#  Actions → Variables); the deploy workflow forwards every VITE_* variable.
#
#  !! Every VITE_* value is PUBLIC: Vite inlines it into the JavaScript that
#  !! visitors download. NEVER put a secret here — in particular never the
#  !! Supabase `service_role` key or a Twitch client secret.
# ═════════════════════════════════════════════════════════════════════════


# ── Supabase (required) ───────────────────────────────────────────────────
# Project Settings → API. The anon / publishable key is designed to be public;
# access is restricted by Row Level Security in the database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ── Deployment ────────────────────────────────────────────────────────────
# Canonical public URL (no trailing slash). Used for canonical / Open Graph
# tags, sitemap.xml and the CNAME file. The deploy workflow fills this in
# from the GitHub Pages settings automatically; set it only to override.
VITE_SITE_URL=https://nimp.ee

# Base path the site is served from. "/" for a custom domain,
# "/<repository>/" for https://<user>.github.io/<repository>/.
# The deploy workflow sets this automatically — leave empty locally.
VITE_BASE_PATH=

# IANA time zone all dates are displayed in (default: Europe/Tallinn).
VITE_SITE_TIMEZONE=Europe/Tallinn


# ── Streamer identity (all optional) ──────────────────────────────────────
# Defaults live in src/config/streamer.defaults.ts. Anything set here
# overrides that file; anything set in /admin/settings overrides both.
VITE_STREAMER_NAME=NIMP
VITE_STREAMER_DISPLAY_NAME=NIMP
VITE_STREAMER_TAGLINE=Twitch streamer
# SEO meta description. Empty = generated from the name.
VITE_STREAMER_DESCRIPTION=
# "About" text. Use \n\n between paragraphs.
VITE_STREAMER_ABOUT=
# Comma-separated topic chips, e.g. "Just Chatting, CS2". Empty = hidden.
VITE_STREAMER_TAGS=
VITE_STREAMER_IMAGE=https://static-cdn.jtvnw.net/jtv_user_pictures/3e941dba-810a-4555-b6b6-57c2fa7603e2-profile_image-70x70.png
VITE_STREAMER_BUSINESS_EMAIL=

# Social links. Empty = that icon is not shown.
VITE_STREAMER_TWITCH_URL=https://www.twitch.tv/nimp
VITE_STREAMER_INSTAGRAM_URL=
VITE_STREAMER_YOUTUBE_URL=
VITE_STREAMER_TIKTOK_URL=
VITE_STREAMER_DISCORD_URL=
VITE_STREAMER_FACEBOOK_URL=
VITE_STREAMER_X_URL=
VITE_STREAMER_STEAM_URL=

# Intro sentence under the name on the home page. Empty = default text.
VITE_STREAMER_HERO_LEAD=

# Heading of the Twitch call-to-action band.
VITE_STREAMER_TWITCH_CTA_TITLE=Vaata NIMPi live
# Extra footer text (disclaimers etc.). Use \n for line breaks.
VITE_STREAMER_FOOTER_TEXT=


# ── Colour palette (optional, "#rrggbb") ──────────────────────────────────
# The whole colour scheme derives from these five values.
# Keep the quotes: in a .env file an unquoted # starts a comment.
VITE_STREAMER_THEME_PRIMARY="#8f5bff"
VITE_STREAMER_THEME_ACCENT="#c6f432"
VITE_STREAMER_THEME_BACKGROUND="#0b0a10"
VITE_STREAMER_THEME_SURFACE="#15131d"
VITE_STREAMER_THEME_TEXT="#f3f1f8"


# ── Optional module: Twitch live status ───────────────────────────────────
# URL of the deployed `twitch-status` edge function, e.g.
# https://<project-ref>.supabase.co/functions/v1/twitch-status
# Empty = module disabled (the site works exactly the same without it).
# The Twitch API credentials are NOT set here — they are edge-function
# secrets (see README → "Optional: Twitch live status").
VITE_TWITCH_STATUS_URL=
